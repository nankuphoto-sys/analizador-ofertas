# Un archivo por entorno. Copia este como el que necesites y rellénalo (ver docs/entornos.md):
#   .env.production   tu uso real            → npm run buscar:prod
#   .env.test         pruebas y evaluación   → npm run evaluar, npm run buscar:test
#   .env.development  no lo necesitas: desarrollo no usa llave a propósito (npm test, npm run typecheck)
# Cada entorno con SU propia llave de https://console.anthropic.com/settings/keys, idealmente de un
# workspace distinto con su propio límite de gasto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Límite de gasto en la API (dólares). Antes de cada análisis se revisa que lo gastado más lo que suele
# costar uno no pase estos topes. Lo gastado se anota en el memoria/gasto.json de cada entorno.
# Ver docs/limite-de-gasto.md. Sugerido: producción 2 y 20; pruebas 3 y 5 (una evaluación completa cuesta unos US$ 1,2 a 2,5).
LIMITE_USD_DIA=2
LIMITE_USD_MES=20
