# Copia este archivo como .env y pon tu clave de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Límite de gasto en la API (dólares). Antes de cada análisis se revisa que lo gastado más lo que suele
# costar uno no pase estos topes. Lo gastado se anota en memoria/gasto.json. Ver docs/limite-de-gasto.md.
LIMITE_USD_DIA=2
LIMITE_USD_MES=20
