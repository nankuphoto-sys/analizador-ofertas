{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(./memoria/**)",
      "Write(./memoria/**)"
    ],
    "ask": [
      "Bash(npm run olvidar:*)",
      "Bash(npm run evaluar:*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./equipo-agentes/**)",
      "Write(./equipo-agentes/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/permisos.mjs\" --desde-settings"
          }
        ]
      }
    ]
  }
}
